  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Version"
          },
          "reviewed": {
            "type": "boolean",
            "const": true,
            "title": "Reviewed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "reviewed"
        ],
        "title": "Approval"
      },
      "Body_upload_api_v1_disputes__identity__upload_post": {
        "properties": {
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Version"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "version",
          "file"
        ],
        "title": "Body_upload_api_v1_disputes__identity__upload_post"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "DraftEdit": {
        "properties": {
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Version"
          },
          "text": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 20,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "text"
        ],
        "title": "DraftEdit"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewDispute": {
        "properties": {
          "paypal_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Paypal Id"
          },
          "customer": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Customer"
          },
          "reason": {
            "type": "string",
            "enum": [
              "MERCHANDISE_OR_SERVICE_NOT_RECEIVED",
              "MERCHANDISE_OR_SERVICE_NOT_AS_DESCRIBED",
              "UNAUTHORISED",
              "UNAUTHORIZED_TRANSACTION",
              "NOT_RECOGNISED",
              "NOT_RECOGNIZED",
              "INQUIRY"
            ],
            "title": "Reason"
          },
          "amount_cents": {
            "type": "integer",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Cents"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "CAD",
              "AUD"
            ],
            "title": "Currency",
            "default": "USD"
          },
          "due_at": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Due At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paypal_id",
          "customer",
          "reason",
          "amount_cents",
          "due_at"
        ],
        "title": "NewDispute"
      },
      "NewEvidence": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Title"
          },
          "kind": {
            "type": "string",
            "enum": [
              "INVOICE",
              "TRACKING",
              "COMMUNICATION",
              "OTHER"
            ],
            "title": "Kind"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 5,
            "title": "Content"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Version"
          }
