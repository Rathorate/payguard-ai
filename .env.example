# Environment variables are read from the process, not automatically from this file.
# Docker Compose and scripts/dev.sh load .env. Direct Python commands need exported values.
DEMO_MODE=true
DATABASE_URL=sqlite:///./payguard.db
APP_ORIGIN=http://127.0.0.1:3000
SECURE_COOKIES=false

# Hosted demos: HTTPS APP_ORIGIN and SECURE_COOKIES=true; retain DEMO_MODE=true.
# DEMO_MODE=false enables real provider submission and requires separate validation.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Create an account, then use `python -m app.manage tenants` to find its ID.
PAYPAL_TENANT_ID=
# Keep DEMO_MODE=true without PayPal access. All submissions remain simulated,
# even when Groq is enabled. Never put these server keys in frontend variables.
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: one validated JSON-mode recovery after strict-schema generation fails.
GROQ_SCHEMA_RECOVERY=false
OPENAI_API_KEY=
# Choose a Responses API model available to your account.
OPENAI_MODEL=
