# Environment variables are read from the process, not automatically from this file.
# Docker Compose loads .env. For local use, export these values in your terminal.
DEMO_MODE=true
DATABASE_URL=sqlite:///./payguard.db
APP_ORIGIN=http://127.0.0.1:3000
SECURE_COOKIES=false

# Set DEMO_MODE=false, HTTPS APP_ORIGIN, and SECURE_COOKIES=true for deployment.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Create an account, then use `python -m app.manage tenants` to find its ID.
PAYPAL_TENANT_ID=
# Keep DEMO_MODE=true without PayPal access. All submissions remain simulated,
# even when Groq is enabled. Never put these server keys in frontend variables.
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
# Choose a Responses API model available to your account.
OPENAI_MODEL=
